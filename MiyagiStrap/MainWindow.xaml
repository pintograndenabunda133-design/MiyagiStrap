<Window x:Class="MiyagiStrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Miyagi Strap" Width="960" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="None" BorderBrush="#FF6FB5" BorderThickness="1">

    <Window.Resources>
        <Style x:Key="SakuraButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2A1A5E"/>
            <Setter Property="Background" Value="#FF6FB5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="24,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFC2DD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFC2DD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#FF6FB5"
                                BorderThickness="1" CornerRadius="10" Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FF6FB5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFC2DD"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FF6FB5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFC2DD"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" Height="46">
                            <Grid>
                                <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="#FF6FB5" Visibility="Hidden"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="24,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FF6FB5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FF6FB5"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFC2DD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#33FFFFFF" BorderBrush="#55FF6FB5" BorderThickness="1"
                                CornerRadius="8" Padding="14,7" Margin="0,0,8,0">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FF6FB5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF6FB5"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="#2A1A5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#D92A1A5E"/>
            <Setter Property="BorderBrush" Value="#55FF6FB5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC2DD"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7B8EE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC2DD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Assets/fundo.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#8C1A0F3D"/>
        <Canvas x:Name="PetalCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#99120A33" MouseLeftButtonDown="TopBar_MouseDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource TitleBtn}" Click="MinBtn_Click"/>
                        <Button Content="✕" Style="{StaticResource TitleBtn}" Click="CloseBtn_Click"/>
                    </StackPanel>
                    <TextBlock Text="宮城  Miyagi Strap" Foreground="#FFC2DD" FontSize="14"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Sidebar" Grid.Column="0" Background="#B3170D3F">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Miyagi Strap 1.0" Style="{StaticResource Muted}"
                                   Margin="24,0,0,18"/>
                        <StackPanel Margin="0,16,0,0">
                            <RadioButton x:Name="NavHome" Content="Início" Tag="home" GroupName="nav"
                                         Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavFlags" Content="FastFlags" Tag="flags" GroupName="nav"
                                         Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLook" Content="Aparência" Tag="look" GroupName="nav"
                                         Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout" Content="Sobre" Tag="about" GroupName="nav"
                                         Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="ContentArea" Grid.Column="1" Margin="28">

                    <Grid x:Name="PanelHome">
                        <Border Style="{StaticResource Card}" Width="420"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="宮城" Foreground="#FF6FB5" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="Miyagi Strap" Foreground="#FFC2DD" FontSize="32"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,24"/>
                                <TextBlock x:Name="StatusText" Text="Pronto para jogar" Foreground="#FFC2DD"
                                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="#FF6FB5" Background="#3A2A7A" BorderThickness="0"
                                             Margin="0,0,0,24"/>
                                <Button x:Name="LaunchButton" Content="Jogar Roblox"
                                        Style="{StaticResource SakuraButton}" Click="LaunchButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="PanelFlags" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="FastFlags" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                       Text="Ajustes avançados do Roblox. O Roblox só aceita uma lista de flags permitidas, então nem toda flag funciona."/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Limite de FPS" Style="{StaticResource Lbl}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="FpsSlider" Minimum="0" Maximum="360" TickFrequency="10"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="FpsSlider_Changed"/>
                                        <TextBlock x:Name="FpsText" Grid.Column="1" Text="Padrão" Foreground="#FFC2DD"
                                                   FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="Renderizador" Style="{StaticResource Lbl}"/>
                                    <StackPanel x:Name="RendererPanel" Orientation="Horizontal">
                                        <RadioButton Content="Automático" Tag="auto" GroupName="renderer" Style="{StaticResource Chip}"/>
                                        <RadioButton Content="DirectX 11" Tag="d3d11" GroupName="renderer" Style="{StaticResource Chip}"/>
                                        <RadioButton Content="Vulkan" Tag="vulkan" GroupName="renderer" Style="{StaticResource Chip}"/>
                                    </StackPanel>

                                    <TextBlock Text="Antisserrilhado (MSAA)" Style="{StaticResource Lbl}"/>
                                    <StackPanel x:Name="MsaaPanel" Orientation="Horizontal">
                                        <RadioButton Content="Padrão" Tag="-1" GroupName="msaa" Style="{StaticResource Chip}"/>
                                        <RadioButton Content="2x" Tag="2" GroupName="msaa" Style="{StaticResource Chip}"/>
                                        <RadioButton Content="4x" Tag="4" GroupName="msaa" Style="{StaticResource Chip}"/>
                                        <RadioButton Content="8x" Tag="8" GroupName="msaa" Style="{StaticResource Chip}"/>
                                    </StackPanel>

                                    <TextBlock Text="Flags personalizadas (JSON)" Style="{StaticResource Lbl}"/>
                                    <TextBox x:Name="CustomBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                             Background="#33000000" Foreground="#FFC2DD" BorderBrush="#55FF6FB5"
                                             CaretBrush="#FFC2DD" Padding="8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Content="Salvar" Style="{StaticResource SakuraButton}" Click="SaveFlags_Click"/>
                                        <TextBlock x:Name="FlagsStatus" Foreground="#FFC2DD" FontSize="13"
                                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="PanelLook" Visibility="Collapsed">
                        <TextBlock Text="Aparência" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                   Text="Deixe o Miyagi Strap do seu jeito."/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="PetalsCheck" Content="Pétalas de sakura caindo" Foreground="#FFC2DD"
                                          FontSize="14" Checked="Look_Changed" Unchecked="Look_Changed"/>
                                <TextBlock Text="Quantidade de pétalas" Style="{StaticResource Lbl}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PetalSlider" Minimum="0" Maximum="40" TickFrequency="2"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="Look_Changed"/>
                                    <TextBlock x:Name="PetalText" Grid.Column="1" Text="16" Foreground="#FFC2DD"
                                               FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <TextBlock Text="Sobre" Style="{StaticResource H1}"/>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Miyagi Strap 1.0" Foreground="#FFC2DD" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="0,8,0,18"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Abrir pasta" Style="{StaticResource GhostButton}"
                                            Click="OpenFolder_Click" Margin="0,0,10,0"/>
                                    <Button Content="Desinstalar" Style="{StaticResource GhostButton}"
                                            Click="Uninstall_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PanelInstall" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Width="460"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="宮城" Foreground="#FF6FB5" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="Instalar Miyagi Strap" Foreground="#FFC2DD" FontSize="28"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,18"/>
                            <TextBlock Text="O Miyagi Strap será instalado em:" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="InstallPathText" Foreground="#FFC2DD" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,4,0,16"/>
                            <CheckBox x:Name="ChkDesktop" Content="Atalho na área de trabalho" IsChecked="True"
                                      Foreground="#FFC2DD" FontSize="14" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkStartMenu" Content="Atalho no Menu Iniciar" IsChecked="True"
                                      Foreground="#FFC2DD" FontSize="14"/>
                            <TextBlock x:Name="InstallStatus" Foreground="#FFB38A" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <Button x:Name="InstallButton" Content="Instalar" Style="{StaticResource SakuraButton}"
                                    Margin="0,18,0,0" Click="InstallButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
